# Enquiry delivery — DESIGN_BRIEF.md §4.12
# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.

# Where website enquiries are emailed.
ENQUIRY_TO_EMAIL=

# The From address. With Resend this must be on a domain verified in your
# Resend account. Before the domain is set up, onboarding@resend.dev works for
# testing and delivers only to the address that owns the Resend account.
ENQUIRY_FROM_EMAIL=

# API key from https://resend.com
RESEND_API_KEY=

# Absolute origin, used for canonical URLs, Open Graph and the sitemap.
# MUST be set in production — a canonical tag pointing at localhost deindexes
# the site. Example: https://srimaruthitextiles.com
NEXT_PUBLIC_SITE_URL=
